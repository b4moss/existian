{
  "name": "@b4moss/existian",
  "version": "0.1.0",
  "description": "Declarative async existence checks via HTML data-* attributes",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/existian.cjs",
  "module": "./dist/existian.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/existian.iife.min.js",
  "jsdelivr": "./dist/existian.iife.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/existian.js",
      "require": "./dist/existian.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "node ./scripts/build.mjs",
    "test": "vitest run --coverage",
    "ci:local:fallback": "npm ci && npm test && npm run build"
  },
  "keywords": [
    "existence",
    "async",
    "validation",
    "data-attributes",
    "debounce"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/b4moss/existian.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  }
}
